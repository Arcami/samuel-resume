---
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/game.png";

interface Props {
  title: string;
  developer: string;
  url?: string;
  image: ImageMetadata;
}

const { title, developer, image, url } = Astro.props;
---

<div class="service-btn" style={`border-image-source: url(${borderImg.src});`}>
  <Image src={image} alt="" />
  <div class="overlay">
    <div class="game-name-dev">
      <p class="game-title">
        {url ? <a href={url}>{title}</a> : title}
      </p>
      <p class="game-developer">{developer}</p>
    </div>
  </div>
</div>

<style>
  /* 1. Define an animation that keeps clicks disabled for a set time, then enables them */
  @keyframes enableInteraction {
    0% {
      pointer-events: none;
    }
    99% {
      pointer-events: none;
    }
    100% {
      pointer-events: auto;
    }
  }

  div.service-btn {
    background-color: transparent;
    border: 1.5em solid rgb(116, 77, 77);
    border-image-slice: 8;
    border-image-repeat: round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-100);
    padding: 0;

    position: relative;

    width: 100%;

    cursor: pointer;
    /* -webkit-tap-highlight-color: transparent; */
  }

  img {
    max-width: none;
    display: block;
    width: calc(100% + 0.26em);
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    image-rendering: auto;
    margin: -0.13em;
  }

  div.overlay {
    position: absolute;
    top: -0.13em;
    left: -0.13em;
    width: calc(100% + 0.26em);
    height: calc(100% + 0.26em);

    color: white;
    background-color: rgba(0, 0, 0, 0.548);
    user-select: text;

    display: flex;
    justify-content: center;
    align-items: center;

    /* DEFAULT (Hidden) */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    /* When hiding (mouse leave), wait for opacity to fade out before hiding visibility */
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  /* 2. HOVER / FOCUS STATE */
  div.service-btn:hover .overlay,
  div.service-btn:focus-within .overlay {
    opacity: 1;
    visibility: visible;

    /* When showing, start opacity fade immediately and show visibility immediately */
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0s;

    /* 
       DESKTOP DEFAULT: 
       Enable clicks immediately. This ensures desktop feels snappy.
    */
    pointer-events: auto;
  }

  /* 3. TOUCH DEVICE PROTECTION 
     We use a media query to detect devices where hovering isn't the primary input.
  */
  @media (hover: none) {
    div.service-btn:hover .overlay,
    div.service-btn:focus-within .overlay {
      /* 
         On mobile, we override the default 'pointer-events: auto'.
         Instead, we run an animation that keeps it 'none' for 300ms.
         
         The result: 
         - Tap 1 triggers :hover styles.
         - Opacity fades in smooth.
         - Click event fires ~10ms later -> Hits pointer-events:none -> Ignored.
         - 300ms later -> Animation finishes -> pointer-events: auto.
         - Tap 2 -> Works.
      */
      animation: enableInteraction 0.3s linear forwards;
      pointer-events: none;
    }
  }

  p {
    margin-block-start: 0.05em;
    margin-block-end: 0.05em;
    font-family: var(--font-family-200);
    font-size: 1rem;
    text-align: center;
  }

  p.game-title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  p.game-developer {
    font-family: var(--font-family-100);
  }

  a {
    color: inherit;
  }
</style>
