---
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/game.png";

interface Props {
  title: string;
  developer: string;
  url: string;
  image: ImageMetadata;
}

const { title, developer, image, url } = Astro.props;
---

<div class="service-btn" style={`border-image-source: url(${borderImg.src});`}>
  <Image src={image} alt="" />
  <div class="overlay">
    <div class="game-name-dev">
      <p class="game-title"><a href={url} target="_blank">{title}</a></p>
      <p class="game-developer">{developer}</p>
    </div>
  </div>
</div>

<style>
  div.service-btn {
    background-color: transparent;
    border: 1.5em solid rgb(116, 77, 77);
    border-image-slice: 8;
    border-image-repeat: round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-100);
    padding: 0;

    position: relative;

    width: 100%;
  }

  img {
    max-width: none;
    display: block;
    width: calc(100% + 0.26em);
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    image-rendering: auto;
    margin: -0.13em;
  }

  div.overlay {
    position: absolute;
    top: -0.13em;
    left: -0.13em;
    width: calc(100% + 0.26em);
    height: calc(100% + 0.26em);
    opacity: 0%;
    color: white;
    background-color: rgba(0, 0, 0, 0.548);
    user-select: text;
    transition: opacity 0.3s ease;

    display: flex;
    justify-content: center;
    align-items: center;
  }

  div.overlay:hover {
    opacity: 1;
  }

  p {
    margin-block-start: 0.05em;
    margin-block-end: 0.05em;
    font-family: var(--font-family-300);
    font-size: 1rem;
    text-align: center;
  }

  p.game-title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  p.game-developer {
    font-family: var(--font-family-100);
  }

  a {
    color: inherit;
  }
</style>

<article></article>
