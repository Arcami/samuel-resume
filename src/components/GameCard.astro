---
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/game.png";

interface Props {
  gameImage: ImageMetadata;
  alt?: string;
}

const { gameImage, alt = "" } = Astro.props;
---

<button
  class="service-btn"
  style={`border-image-source: url(${borderImg.src});`}
>
  <Image src={gameImage} alt="" />
  <div class="overlay">
    <div class="game-name-dev">
      <p class="game-title">Time Princess</p>
      <p class="game-developer">IGG</p>
    </div>
  </div>
</button>

<style>
  button {
    cursor: pointer;
    background-color: transparent;
    border: 1.5em solid rgb(116, 77, 77);
    border-image-slice: 8;
    border-image-repeat: round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-100);
    padding: 0;

    position: relative;

    width: 100%;
  }

  img {
    max-width: none;
    display: block;
    width: calc(100% + 0.26em);
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    image-rendering: auto;
    margin: -0.13em;
  }

  div.overlay {
    position: absolute;
    top: -0.13em;
    left: -0.13em;
    width: calc(100% + 0.26em);
    height: calc(100% + 0.26em);
    opacity: 0%;
    color: white;
    background-color: rgba(0, 0, 0, 0.548);
    user-select: text;
    transition: opacity 0.3s ease;

    display: flex;
    justify-content: center;
    align-items: center;
  }

  div.overlay:hover {
    opacity: 1;
  }

  p {
    margin-block-start: 0.05em;
    margin-block-end: 0.05em;
    font-family: var(--font-family-300);
    font-size: clamp(0.5rem, 1vw, 1rem);
    text-align: center;
  }

  p.game-title {
    font-size: clamp(0.6rem, 1rem, 6rem);
  }
</style>

<article></article>
