---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/testimonials.png";
import borderImgUser from "@assets/image-borders/general.png";

import rightArrow from "@assets/right-arrow.png";
import leftArrow from "@assets/left-arrow.png";

import type { Testimonial } from "@/types";
import testimonials from "@/data/testimonials.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/testimonials/*.{jpeg,jpg,png,gif}",
);

function isValidUrl(urlString: string | undefined) {
  if (!urlString) return false;

  var urlPattern = new RegExp(
    "^(https?:\\/\\/)?" + // validate protocol
      "((([a-z\\d]([a-z\\d-]*[a-z\\d])*)\\.)+[a-z]{2,}|" + // validate domain name
      "((\\d{1,3}\\.){3}\\d{1,3}))" + // validate OR ip (v4) address
      "(\\:\\d+)?(\\/[-a-z\\d%_.~+]*)*" + // validate port and path
      "(\\?[;&a-z\\d%_.~+=-]*)?" + // validate query string
      "(\\#[-a-z\\d_]*)?$",
    "i",
  ); // validate fragment locator
  return !!urlPattern.test(urlString);
}
---

<div class="testimonials-carousel-wrapper">
  <!-- 1. Left Arrow -->
  <div class="swiper-button-prev">
    <Image src={leftArrow} alt="Previous" />
  </div>

  <!-- 2. The Border Image Container -->
  <div
    class="border-container"
    style={`border-image-source: url(${borderImg.src});`}
  >
    <div class="swiper-padding">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          {
            (testimonials as Testimonial[]).map((item) => {
              const imagePath = `/src/assets/testimonials/${item.image}`;
              const isUrl = item.image?.startsWith("http") || false;
              const localImageExists = images[imagePath] !== undefined;
              const showImage = !isUrl && localImageExists;
              return (
                <div class="swiper-slide">
                  {showImage && (
                    <div
                      class="user-img-wrapper"
                      style={`border-image-source: url(${borderImgUser.src});`}
                    >
                      <Image src={images[imagePath]()} alt="" />
                    </div>
                  )}
                  <div class="slide-text">
                    <p class="testimonials-user">{item.user}</p>
                    <p class="testimonials-context">
                      {isValidUrl(item.url) ? (
                        <a
                          href={item.url}
                          target="_blank"
                          set:text={item.context}
                        />
                      ) : (
                        item.context
                      )}
                    </p>
                    <blockquote
                      class="testimonials-quote"
                      set:text={item.quote}
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Right Arrow -->
  <div class="swiper-button-next">
    <Image src={rightArrow} alt="Next" />
  </div>
</div>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  new Swiper(".mySwiper", {
    slidesPerView: 1,
    spaceBetween: 1,
    autoHeight: true,
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
      addIcons: false,
    },
  });
</script>

<style>
  /* --- LAYOUT ARCHITECTURE (MOBILE DEFAULT) --- */

  .testimonials-carousel-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    align-items: center;
    justify-items: center;
  }

  /* --- ARROWS (MOBILE) --- */
  /* On mobile, we want small, square buttons in the bottom row */
  .swiper-button-next,
  .swiper-button-prev {
    /* Reset Swiper Defaults */
    position: static;
    transform: none;
    margin: 0;

    /* Mobile Size */
    width: 48px;
    height: 48px;

    /* Layout internals (Center the image) */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    /* UX Fixes */
    user-select: none;
  }

  /* Place arrows in grid row 2 */
  .swiper-button-prev {
    grid-row: 2;
    grid-column: 1;
    justify-self: end;
  }

  .swiper-button-next {
    grid-row: 2;
    grid-column: 2;
    justify-self: start;
  }

  /* THE ARROW IMAGES (Fixed Size) */
  .swiper-button-next img,
  .swiper-button-prev img {
    height: 40px;
    width: auto;
    pointer-events: none; /* Prevents dragging */
    display: block;
  }

  /* --- CONTENT BOX --- */
  .border-container {
    grid-row: 1;
    grid-column: 1 / -1;
    width: 100%;
    min-width: 0;

    /* Border Styling */
    border-image-slice: 2 3 2 3 fill;
    border-image-width: 20px;
    border-image-repeat: stretch stretch;
    border-style: solid;
    image-rendering: pixelated;
  }

  .swiper-padding {
    padding: 3rem 2rem;
  }

  .swiper {
    width: 100%;
  }

  .swiper-slide {
    display: flex;
    gap: 1rem;
    align-items: center;
    height: auto;
    flex-direction: column;
  }

  .slide-text {
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  p,
  blockquote,
  a {
    color: var(--color-primary-100);
    text-align: left;
  }

  p.testimonials-user {
    font-family: var(--font-family-200);
    font-size: 1rem;
    margin: 0;
    line-height: 2;
  }

  .testimonials-context {
    font-family: var(--font-family-200);
    font-size: 0.75rem;
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  blockquote {
    font-size: 1rem;
    margin: 0;
    line-height: 1.4;
  }

  blockquote::before {
    content: "“";
  }
  blockquote::after {
    content: ".”";
  }

  /* --- USER IMAGE STYLING --- */
  .user-img-wrapper {
    flex-shrink: 0;
    width: 7.75rem;
    height: 7.75rem;
    border-style: solid;
    border-width: 0.625rem;
    border-image-slice: 2;
    border-image-repeat: stretch;
    image-rendering: pixelated;
    display: block;
    box-sizing: border-box;
  }

  .user-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    image-rendering: auto;
  }

  /* --- DESKTOP BREAKPOINT (Tablets & Up) --- */
  @media (min-width: 768px) {
    .testimonials-carousel-wrapper {
      display: flex; /* Switch to Flexbox */

      /* THIS IS THE KEY: Force all 3 items to be equal height */
      align-items: stretch;

      justify-content: center;
      gap: 1rem;
    }

    /* Reset positioning */
    .swiper-button-prev,
    .swiper-button-next,
    .border-container {
      grid-row: auto;
      grid-column: auto;
      justify-self: auto;
    }

    /* Make the content box take available width */
    .border-container {
      flex: 1;
    }

    /* ARROW BUTTONS ON DESKTOP */
    .swiper-button-prev,
    .swiper-button-next {
      /* Remove fixed height so they can stretch to match the container */
      height: auto;

      /* Flex settings here ensure the ICON stays centered, even if the button is 300px tall */
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .swiper-padding {
      padding: 3rem;
    }

    .swiper-slide {
      gap: 1.5rem;
      flex-direction: row;
      align-items: center;
    }

    p.testimonials-context {
      margin-bottom: 1rem;
    }
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline dashed var(--color-primary-700) 6px;
  }
</style>
