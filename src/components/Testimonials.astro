---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/testimonials.png";
import borderImgUser from "@assets/image-borders/general.png";

import rightArrow from "@assets/right-arrow.png";
import leftArrow from "@assets/left-arrow.png";

import type { Testimonial } from "@/types";
import testimonials from "@/data/testimonials.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/testimonials/*.{jpeg,jpg,png,gif}"
);
---

<div class="testimonials-carousel-wrapper">
  <!-- 1. Left Arrow -->
  <div class="swiper-button-prev">
    <Image src={leftArrow} alt="Previous" />
  </div>

  <!-- 2. The Border Image Container -->
  <div
    class="border-container"
    style={`border-image-source: url(${borderImg.src});`}
  >
    <div class="swiper-padding">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          {
            (testimonials as Testimonial[]).map((item) => {
              const imagePath = `/src/assets/testimonials/${item.image}`;
              const isUrl = item.image?.startsWith("http") || false;
              const localImageExists = images[imagePath] !== undefined;
              const showImage = !isUrl && localImageExists;
              return (
                <div class="swiper-slide">
                  {showImage && (
                    <Image
                      src={images[imagePath]()}
                      alt=""
                      style={`border-image-source: url(${borderImgUser.src});`}
                    />
                  )}
                  <div class="slide-text">
                    <p class="testimonials-user">{item.user}</p>
                    <p class="testimonials-context">{item.context}</p>
                    <blockquote class="testimonials-quote">
                      {item.quote}
                    </blockquote>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Right Arrow -->
  <div class="swiper-button-next">
    <Image src={rightArrow} alt="Next" />
  </div>
</div>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  new Swiper(".mySwiper", {
    slidesPerView: 1,
    spaceBetween: 1,
    autoHeight: true, // This helps the container shrink/grow based on text amount
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
      addIcons: false,
    },
  });
</script>

<style>
  /* --- LAYOUT ARCHITECTURE --- */

  /* MOBILE DEFAULT: Grid Layout */
  /* This stacks the box on top (spanning full width) and arrows below */
  .testimonials-carousel-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two columns for the arrows */
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    align-items: center;
    justify-items: center;
  }

  /* Place arrows in the second row */
  .swiper-button-prev {
    grid-row: 2;
    grid-column: 1;
    justify-self: end; /* Push to center */
  }

  .swiper-button-next {
    grid-row: 2;
    grid-column: 2;
    justify-self: start; /* Push to center */
  }

  /* Place content in the first row, spanning BOTH columns */
  .border-container {
    grid-row: 1;
    grid-column: 1 / -1; /* Span full width */

    width: 100%;
    min-width: 0;

    /* Border Styling */
    border-image-slice: 2 3 2 3 fill;
    border-image-width: 20px;
    border-image-repeat: stretch stretch;
    border-style: solid;
    image-rendering: pixelated;
  }

  /* --- INTERNAL SPACING & TYPOGRAPHY --- */

  .swiper-padding {
    padding: 1.5rem 1rem; /* Tight padding on mobile */
  }

  .swiper {
    width: 100%;
  }

  .swiper-slide {
    display: flex;
    gap: 1rem;
    align-items: flex-start; /* Align text to top of image */
    height: auto;
  }

  .slide-text {
    flex: 1; /* Allow text to fill remaining space */
    min-width: 0; /* Critical for wrapping inside flex */
  }

  p,
  blockquote {
    color: var(--color-primary-100);
    text-align: left;
  }

  p.testimonials-user {
    font-family: var(--font-family-200);
    font-size: 1rem; /* Smaller font on mobile */
    margin: 0;
    line-height: 1.2;
  }

  p.testimonials-context {
    font-family: var(--font-family-200);
    font-size: 0.75rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  blockquote {
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.4;
  }

  /* Image Styling */
  .swiper-slide img {
    border-image-slice: 2 2 2 2;
    border-image-repeat: stretch stretch;
    border-style: solid;
    image-rendering: pixelated;
    border-width: 0.5rem;

    width: 3.5rem; /* Smaller avatar on mobile */
    height: 3.5rem;
    flex-shrink: 0;
  }

  /* Arrow Button Reset */
  .swiper-button-next,
  .swiper-button-prev {
    position: static;
    transform: none;
    margin: 0;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swiper-button-next img,
  .swiper-button-prev img {
    height: 100%;
    width: auto;
  }

  /* --- DESKTOP BREAKPOINT (Tablets & Up) --- */
  /* Switch back to the "Classic" wide layout */
  @media (min-width: 768px) {
    .testimonials-carousel-wrapper {
      display: flex; /* Flex row */
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    /* Reset positioning for Flex */
    .swiper-button-prev,
    .swiper-button-next,
    .border-container {
      grid-row: auto;
      grid-column: auto;
      justify-self: auto;
    }

    .border-container {
      flex: 1; /* Take up middle space */
    }

    .swiper-padding {
      padding: 3rem;
    }

    .swiper-slide {
      gap: 1.5rem;
      align-items: center;
    }

    .swiper-slide img {
      width: 7.75rem;
      height: 7.75rem;
      border-width: 0.625rem;
    }

    p.testimonials-user {
      font-size: var(--font-size-600);
    }
    p.testimonials-context {
      font-size: 1rem;
      margin-bottom: 1rem;
    }
    blockquote {
      font-size: var(--font-size-200);
    }
  }
</style>
