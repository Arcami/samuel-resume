---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/testimonials.png";
import borderImgUser from "@assets/image-borders/general-transparent.png";

import rightArrow from "@assets/right-arrow.png";
import leftArrow from "@assets/left-arrow.png";

import type { Testimonial } from "@/types";
import testimonials from "@/data/testimonials.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/testimonials/*.{jpeg,jpg,png,gif}",
);

function isValidUrl(urlString: string | undefined) {
  if (!urlString) return false;

  var urlPattern = new RegExp(
    "^(https?:\\/\\/)?" +
      "((([a-z\\d]([a-z\\d-]*[a-z\\d])*)\\.)+[a-z]{2,}|" +
      "((\\d{1,3}\\.){3}\\d{1,3}))" +
      "(\\:\\d+)?(\\/[-a-z\\d%_.~+]*)*" +
      "(\\?[;&a-z\\d%_.~+=-]*)?" +
      "(\\#[-a-z\\d_]*)?$",
    "i",
  );

  return !!urlPattern.test(urlString);
}
---

<div class="testimonials-carousel-wrapper">
  <div class="swiper-button-prev">
    <Image src={leftArrow} alt="Previous" />
  </div>

  <div
    class="border-container"
    style={`border-image-source: url(${borderImg.src});`}
  >
    <div class="swiper-padding">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          {
            (testimonials as Testimonial[]).map((item) => {
              const imagePath = `/src/assets/testimonials/${item.image}`;
              const isUrl = item.image?.startsWith("http") || false;
              const localImageExists = images[imagePath] !== undefined;
              const showImage = !isUrl && localImageExists;
              return (
                <div class="swiper-slide">
                  {showImage && (
                    <div
                      class="user-img-wrapper"
                      style={`border-image-source: url(${borderImgUser.src});`}
                    >
                      <Image src={images[imagePath]()} alt="" />
                    </div>
                  )}
                  <div class="slide-text">
                    <p class="testimonials-user">{item.user}</p>
                    <p class="testimonials-context">
                      {isValidUrl(item.url) ? (
                        <a href={item.url} set:text={item.context} />
                      ) : (
                        item.context
                      )}
                    </p>
                    <blockquote
                      class="testimonials-quote"
                      set:text={item.quote}
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <div class="swiper-button-next">
    <Image src={rightArrow} alt="Next" />
  </div>
  <div class="swiper-pagination"></div>
</div>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  const isMobile = function () {
    if (window.matchMedia("(any-hover:none)").matches) {
      return true;
    } else {
      return false;
    }
  };

  new Swiper(".mySwiper", {
    slidesPerView: 1,
    spaceBetween: 1,
    autoHeight: true,
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
      addIcons: false,
    },
    allowTouchMove: isMobile() ? true : false,
    pagination: {
      el: ".swiper-pagination",
      type: "fraction",
      renderFraction: (currentClass, totalClass) => {
        return `<span class=${currentClass}></span>/<span class=${totalClass}></span>`;
      },
    },
  });
</script>

<style>
  .swiper-pagination {
    position: static;
    color: var(--color-secondary-500);
    font-family: var(--font-family-200);
    grid-area: pagination;
  }

  .testimonials-carousel-wrapper {
    display: grid;

    align-items: center;

    gap: 1rem;
    width: 100%;
    max-width: 100%;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "content content content"
      "prev pagination next";
  }

  .swiper-button-next,
  .swiper-button-prev {
    display: flex;
    position: static;
    justify-content: center;
    align-items: center;
    transform: none;
    cursor: pointer;
    margin: 0;

    width: 48px;
    height: 48px;

    user-select: none;
  }

  .swiper-button-next img,
  .swiper-button-prev img {
    display: block;
    width: auto;
    height: 40px;
    pointer-events: none;
  }

  .border-container {
    border-style: solid;

    border-image-slice: 2 3 2 3 fill;
    border-image-width: 20px;
    border-image-repeat: stretch stretch;
    image-rendering: pixelated;
    width: 100%;
    min-width: 0;

    grid-area: content;
  }

  .swiper-padding {
    padding: 3rem 2rem;
  }

  .swiper {
    width: 100%;
  }

  .swiper-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    height: auto;
  }

  .slide-text {
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  p,
  blockquote,
  a {
    color: var(--color-primary-100);
    text-align: left;
  }

  p.testimonials-user {
    margin: 0;
    font-size: 1rem;
    line-height: 2;
    font-family: var(--font-family-200);
    text-align: center;
  }

  p.testimonials-context {
    opacity: 0.7;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-family-200);
    text-align: center;
  }

  blockquote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  blockquote::before {
    content: "“";
  }
  blockquote::after {
    content: ".”";
  }

  .user-img-wrapper {
    display: block;
    flex-shrink: 0;
    box-sizing: border-box;
    border-width: 0.625rem;
    border-style: solid;
    border-image-slice: 2;
    border-image-repeat: stretch;
    image-rendering: pixelated;
    width: 7.75rem;
    height: 7.75rem;
  }

  .user-img-wrapper img {
    display: block;
    image-rendering: auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .swiper-button-prev {
    grid-area: prev;
  }

  .swiper-button-next {
    grid-area: next;
  }

  @media (min-width: 768px) {
    .testimonials-carousel-wrapper {
      display: grid;
      grid-template-columns: auto 1fr auto;
      justify-content: center;

      align-items: stretch;
      gap: 1rem;
    }

    .swiper-button-prev,
    .swiper-button-next,
    .border-container {
      grid-row: auto;
      grid-column: auto;
      justify-self: auto;
    }

    .border-container {
      flex: 1;
    }

    .swiper-button-prev,
    .swiper-button-next {
      display: flex;
      justify-content: center;
      align-items: center;

      height: auto;
    }

    .swiper-padding {
      padding: 3rem;
    }

    .swiper-slide {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }

    p.testimonials-user {
      text-align: left;
    }

    p.testimonials-context {
      margin-bottom: 1rem;
      text-align: left;
    }
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: var(--green-hover-underline);
    text-decoration-skip-ink: none;
  }
</style>
