---
// Counter.astro
interface Props {
  value?: number | string;
}

const { value = 1000 } = Astro.props;
---

<span class="counter" data-target={String(value)}>{value}</span>

<style is:global>
  .counter {
    display: inline-flex;
    overflow: hidden;
    height: 1em;
    line-height: 1;
  }

  .counter > span {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 2s ease;
    transform: translateY(0);
    line-height: 1;
  }

  .counter > span span {
    flex: 0 0 100%;
    height: 100%;
  }
</style>

<script is:inline>
  (function () {
    if (window.__counterInit) return;
    window.__counterInit = true;

    document.querySelectorAll(".counter").forEach((stat, index) => {
      const targetValue = stat.getAttribute("data-target");

      // New parsing: split into digits and non-digits, handles ANY length
      const result = targetValue.match(/\d+|\D+/g) || [];

      stat.innerHTML = "";

      for (let res of result) {
        if (isNaN(res)) {
          // Non-number characters (like $ . , M K)
          stat.insertAdjacentHTML("beforeend", `<span>${res}</span>`);
        } else {
          // Number - create animated digits
          for (let i = 0; i < res.length; i++) {
            stat.insertAdjacentHTML(
              "beforeend",
              `<span data-value="${res[i]}">
                <span>&ndash;</span>
                ${Array(parseInt(res[i]) + 1)
                  .join(0)
                  .split(0)
                  .map((x, j) => `<span>${j}</span>`)
                  .join("")}
              </span>`
            );
          }
        }
      }

      const ticks = [...stat.querySelectorAll("span[data-value]")];

      setTimeout(
        () => {
          ticks.forEach((tick) => {
            const dist = parseInt(tick.getAttribute("data-value")) + 1;
            tick.style.transform = `translateY(-${dist * 100}%)`;
          });
        },
        300 + index * 150
      );
    });
  })();
</script>
