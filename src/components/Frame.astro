---
import frame from "@assets/frame.png";

interface Props {
  src: string;
  alt?: string;
  title?: string;
  link?: string;
}

const { src, alt = "", title, link } = Astro.props;
---

<div class="framed" style={`background-image: url(${frame.src})`}>
  {
    link ? (
      <a
        class="no-external-indicator framed-link"
        href={link}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src={src} alt={alt} title={title} />
      </a>
    ) : (
      <img src={src} alt={alt} title={title} />
    )
  }
</div>

<style>
  .framed {
    /* 1. Responsiveness */
    width: 100%;
    aspect-ratio: 1 / 1;

    /* 2. The Frame Rendering */
    background: center / 100% 100% no-repeat;
    image-rendering: pixelated;

    /* 3. The Math
       Since the frame is 1 unit thick on an 18 unit grid:
       1 / 18 = 5.55...% 
       We set this as padding. The content box is now the "safe zone". */
    padding: calc(100% / 18);

    /* Ensure padding is included in the width calculation if you add borders later */
    box-sizing: border-box;

    /* 4. Layout: Ensures the child (img or a) fills the content box */
    display: flex;
  }

  /* Make the link fill the available space inside the padding */
  .framed-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: auto; /* Keep the inner photo smooth */

    /* Optional: If your frame has rounded corners inside, 
       you might need a slight border-radius here to clip the image */
  }
</style>
