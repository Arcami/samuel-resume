<style>
  header {
    position: sticky;
    top: 0;
    margin-top: 0.5rem;
    z-index: 999;
    width: 100%;
    max-width: 1248px;
    margin-bottom: 2rem;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;

    font-family: var(--font-family-100);
    font-size: clamp(1rem, 0.964rem + 0.179vw, 1.25rem);
    background-color: rgb(87 69 38);
    border-image-source: url("/nav.png");
    border-image-slice: 20 28 20 28;
    border-image-slice: stretch repeat;
    color: var(--color-primary-100);
    border-image-width: 1.25rem;
    padding: 1.5rem clamp(1.5rem, 0.3539rem + 2.3845vw, 2.5rem);
  }

  nav a {
    color: var(--color-primary-100);
    text-decoration: none;
    display: flex;
  }

  ul#section-list {
    list-style: none;
    display: flex;
    gap: 24px;
    align-items: center;
    padding-inline-start: 0;
    margin: 0;
  }

  .translate-button img {
    height: auto;
    width: calc(clamp(1rem, 0.964rem + 0.179vw, 1.25rem) * 1.2);
  }

  #open-sidebar-button,
  #close-sidebar-button {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
  }

  .close-li {
    display: none;
  }

  #nav-overlay {
    background-color: rgba(0, 0, 0, 0.5);
    position: fixed;
    inset: 0;
    z-index: 9;
    display: none;
    /* Basic fade for overlay */
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  #nav-overlay.show {
    display: block;
    opacity: 1;
  }

  @media screen and (max-width: 942px) {
    #open-sidebar-button {
      display: block;
      margin-left: auto;
    }

    .close-li {
      display: block;
    }

    #close-sidebar-button {
      display: block;
      padding: 1em;
    }

    ul#section-list {
      position: fixed;
      top: 0;
      /* ROLLBACK: Use right -100% instead of transform */
      right: -100%;
      height: 100vh;
      width: min(15em, 100%);
      z-index: 10;
      background-color: green;

      flex-direction: column;
      gap: 0;
      align-items: flex-start;

      /* Animate 'right' */
      transition: right 300ms ease-out;
    }

    ul#section-list.show {
      right: 0;
    }

    ul#section-list li {
      width: 100%;
    }

    ul#section-list a {
      width: 100%;
      padding: 1em 2.5em;
    }

    ul#section-list .close-li {
      padding: 1rem;
      margin-bottom: 2rem;
    }

    .logo-link {
      width: 50%;
    }

    nav {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }
</style>
