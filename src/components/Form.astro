---
import borderImg from "@assets/image-borders/general.png";
---

<form action="https://formspree.io/f/mqelzyna" method="POST">
  <input type="text" name="name" id="name" placeholder="Your name" required />
  <input
    type="email"
    name="email"
    id="email"
    placeholder="Your email"
    required
  />
  <textarea
    rows="8"
    name="message"
    id="message"
    placeholder="You got games on your phone?"
    required></textarea>
  <input type="submit" value="Send" />
</form>

<style define:vars={{ borderImgSrc: `url(${borderImg.src})` }}>
  form * {
    /* border: px solid rgb(116, 77, 77); */
    border-image-source: var(--borderImgSrc);
    border-image-slice: 6 fill;
    border-image-repeat: round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-100);
    background-color: var(--color-secondary-500);
    border-image-width: 1.25rem;
    color: var(--color-primary-100);
    padding: 0.85rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(var(--color-primary-100-rgb), 0.4);
  }

  form {
    display: flex;
    flex-direction: column;
    /* width: 50%; */
    gap: 10px;
  }

  textarea {
    resize: vertical;
  }

  input[type="submit"] {
    cursor: pointer;
  }

  input[type="submit"]:hover {
    background-color: var(--color-secondary-300);
  }
</style>
