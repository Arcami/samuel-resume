---
import { Image } from "astro:assets";
import borderImg from "@assets/image-borders/general.png";
import email from "@assets/socials/email.png";
import phone from "@assets/socials/phone.png";
import linkedin from "@assets/socials/linkedin.png";
import x from "@assets/socials/x.png";
import bluesky from "@assets/socials/bluesky.png";

const icons = { email, phone, linkedin, x, bluesky };

interface Props {
  icon: keyof typeof icons;
  link: string;
}

const { link } = Astro.props;
const { icon } = Astro.props;
const iconImg = icons[icon];
---

<div class="social-container">
  <div
    class="social-image"
    style={`border-image-source: url(${borderImg.src});`}
  >
    <Image src={iconImg} alt="" />
  </div>
  <p class="social-text">
    <a href={link}>
      <slot />
    </a>
  </p>
</div>

<style>
  .social-text > a {
    color: var(--color-secondary-900);
  }

  div.social-container {
    display: flex;
    align-items: center;
    gap: 1.5em;
    font-size: var(--font-size-600);
    font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    font-size: clamp(1rem, 0.882rem + 0.588vw, 1.25rem);
    max-width: 100%;
  }

  div.social-image {
    background-color: transparent;
    border: solid rgb(116, 77, 77);
    border-image-slice: 6 fill;
    border-image-repeat: round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    border-image-width: 1.25em;
    aspect-ratio: 1 / 1;
    padding: 0.55em;
    flex-shrink: 0;
    width: 2.7083333333333335em;
    height: 2.7083333333333335em;
    flex-shrink: 0;
  }

  img {
    width: auto;
    height: auto;
    image-rendering: auto;
    display: block;
    max-width: 100%;
    aspect-ratio: 1 / 1;
  }

  .social-text {
    min-width: 0;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: var(--green-hover-underline);
    text-decoration-skip-ink: none;
  }
</style>
