---
import type { Lang } from "@/i18n/defaultLangOptions";
import { useTranslations } from "@/i18n/ui";

const currentLocale = Astro.currentLocale as Lang;
const t = useTranslations(currentLocale);
---

<footer>
  <!-- <p>Credits</p>
  <div class="footer-right">
    <p>Legal Notice</p>
    <p>Privacy Policy</p>
    <p>Cookie Policy</p>
  </div> -->
  <p>{t("footer.designBy")}</p>
  <p>
    {t("footer.codeBy")}
    <a href="https://www.linkedin.com/in/arnau-calderon/">Arnau Calderón</a>
  </p>
  <p>
    {t("footer.assetsBy")}
    <a href="https://toadzillart.itch.io/">Toadzillart</a>
  </p>
  <p>
    {t("footer.logoBy")}
    <a href="https://fernandodelriofigueira.com/">Fernando del Río Figueira</a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
    background-color: var(--color-primary-300);
    padding: 0.25rem clamp(0.75rem, 1.786vw + 0.393rem, 2rem);
    width: 100%;
    font-weight: var(--font-weight-500);
    font-size: clamp(0.55rem, 0.643vw + 0.421rem, 1rem);

    background-image:
      url("/footer-top.png"), url("/footer-bottom.png"),
      url("/footer-middle.png");
    background-position:
      top center,
      bottom center,
      center top;
    background-repeat: no-repeat, no-repeat, repeat-y;
    background-size: 100% auto;
    width: 100%;
    max-width: 1248px;
    min-height: 80px;
    image-rendering: pixelated;
    padding-top: 2.5em;
    padding-inline: 3em;
  }

  footer p {
    color: var(--color-primary-100);
  }

  div.footer-right {
    display: flex;
    justify-content: center;
    gap: 2em;
  }

  a {
    color: var(--color-primary-100);
    text-decoration: none;
    &:hover {
      text-decoration: underline;
      text-decoration: underline dashed var(--color-primary-100)
        clamp(0.1875rem, 0.109rem + 0.2956vw, 0.375rem);
    }
  }

  @media (max-width: 768px) {
    footer {
      flex-direction: column;
      align-items: center;
      gap: 1em;
    }
  }
</style>
