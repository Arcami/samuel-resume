---
import { Image } from "astro:assets";
import chestImg from "@assets/Chest.png";
---

<button>
  <Image src={chestImg} alt="" />
  <span>Download my CV!</span>
</button>

<style>
  button {
    cursor: pointer;
    background-color: rgb(87 69 38);
    border: 10px solid rgb(87 69 38);
    border-radius: 9%;
    border-image: url("/download-button-frame.png") 6 round round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-200);
    padding: 1rem;
    font-size: 1.25rem;
    border-image-width: 1.25rem;

    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  button:hover {
    filter: brightness(120%);
  }
</style>
