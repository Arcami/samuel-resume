---
import { Image } from "astro:assets";
import chestImg from "@assets/Chest.png";
import chestImgOpen from "@assets/Chest2.png";
---

<a href="/my-cv.pdf" download="My_CV.pdf">
  <Image src={chestImg} alt="" class="chest-closed" />
  <Image src={chestImgOpen} alt="" class="chest-open" />

  <span>Download my CV!</span>
</a>

<style>
  a {
    cursor: pointer;
    border: 10px solid transparent;
    background-color: rgb(87 69 38);
    border-image: url("/download-button-frame.png") 6 round round;
    image-rendering: pixelated;
    color: var(--color-primary-100);
    font-family: var(--font-family-200);
    padding: 1rem;
    font-size: 0.85rem;
    font-size: clamp(0.85rem, 0.4rem + 1.4vw, 1.25rem);
    font-size: clamp(0.85rem, 0.588rem + 1.059vw, 1.25rem);
    border-image-width: 1.25rem;

    display: flex;
    gap: 1.25rem;
    align-items: center;
    text-decoration: none;
  }

  a:hover {
    background-color: var(--color-secondary-300);
  }

  .chest-closed {
    display: block;
  }
  .chest-open {
    display: none;
  }

  a:hover .chest-closed {
    display: none;
  }

  a:hover .chest-open {
    display: block;
  }
</style>
