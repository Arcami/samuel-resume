---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import "@/styles/global.css";

import DownloadCv from "@/components/DownloadCv.astro";
import Footer from "@/components/Footer.astro";
import Form from "@/components/Form.astro";
import Frame from "@/components/Frame.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import GameCard from "@/components/GameCard.astro";
import Navbar from "@/components/Navbar.astro";
import SeeMore from "@/components/SeeMore.astro";
import SlotCounter from "@/components/SlotCounter";
import SocialLink from "@/components/SocialLink.astro";
import Testimonials from "@/components/Testimonials.astro";

import translatedGames from "@/data/games.json";

import altagram from "@assets/logos/altagram.png";
import igg from "@assets/logos/igg.png";
import indie from "@assets/logos/indie.png";
import loki from "@assets/logos/loki.png";
import linguitronics from "@assets/logos/linguitronics.png";
import taima from "@assets/logos/taima.png";
import gamescribes from "@assets/logos/gamescribes.png";
import digital_hearts from "@assets/logos/digital_hearts.png";
import locpick from "@assets/logos/locpick.png";
import active_gaming_media from "@assets/logos/active_gaming_media.png";
import onesky from "@assets/logos/onesky.png";
import wordarch from "@assets/logos/wordarch.png";

const gameImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/games/*.{jpeg,jpg,png,gif}",
  { eager: true },
);

const visibleGames = translatedGames.slice(0, 6);

const hiddenBatches = [];
for (let i = 6; i < translatedGames.length; i += 6) {
  hiddenBatches.push(translatedGames.slice(i, i + 6));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Samuel de la Torre: Freelance Spanish Game Localizer. Video game, software & web localization with 4+ years of experience."
    />
    <link rel="canonical" href="https://samutoga.com/" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Samuel de la Torre Galán",
        "url": "https://samutoga.com",
        "image": "https://samutoga.com/samuel.jpg",
        "jobTitle": "Game Localizer & Translator",
        "knowsLanguage": ["en", "de", "es"],
        "worksFor": {
          "@type": "Organization",
          "name": "Freelance"
        },
        "sameAs": [
          "https://linkedin.com/in/samutoga",
          "https://x.com/Samutoga",
          "https://bsky.app/profile/samutoga.bsky.social"
        ]
      }
    </script>
    <script
      src="https://app.rybbit.io/api/script.js"
      data-site-id="b7721dd21b9d"
      defer></script>
    <meta property="og:title" content="Samuel de la Torre's portfolio" /><meta
      property="og:description"
      content="Samuel de la Torre: Freelance Spanish Game Localizer. Video game, software & web localization with 4+ years of experience. View my portfolio."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://samutoga.com" />
    <meta
      property="og:image"
      content="https://samutoga.com/samuel_preview.jpg"
    />
    <meta property="og:locale" content="en_GB" />
    <title>Samuel de la Torre Galán: Game Localizer</title>
  </head>
  <body>
    <Navbar />
    <div class="background">
      <div class="padding">
        <main>
          <h1 class="visually-hidden">Samuel de la Torre's portfolio</h1>
          <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/safe-email@1.1.1/dist/safe-email.min.js"
          ></script>
          <section id="about-me">
            <h2>About me</h2>
            <div>
              <div class="sam">
                <Frame
                  src="samuel.jpg"
                  alt="Samuel de la Torre Galán"
                  title="Samuel de la Torre Galán"
                />
              </div>
              <p class="introduction">
                Hi there! My name is <strong>Samuel de la Torre Galán</strong>.
                I'm a freelance EN/DE&gt;ES translator with 4+ years of
                experience, specializing in video game, software, app, and web
                localization.<br /><br />I've mostly worked on popular mobile
                titles, as well as multiplatform indie games. As a gamer and a
                translator, the genres I'm keen on are visual novel, adventure,
                MMORPG, strategy, and fantasy. However, I'm comfortable with any
                other style or subject and always up for a challenge!
              </p>
            </div>
            <DownloadCv />
          </section>
          <section id="services" class="services">
            <h2>Services</h2>
            <div class="services-grid">
              <div class="service">
                <ServiceCard
                  >Video game, software, app & web localization</ServiceCard
                >
              </div>
              <div class="service">
                <ServiceCard>
                  Legal, Technical & Marketing Translation in Gaming
                </ServiceCard>
              </div>
              <div class="service">
                <ServiceCard>LQA & Testing</ServiceCard>
              </div>
              <div class="service">
                <ServiceCard>Proofreading & Editing</ServiceCard>
              </div>
              <div class="service">
                <ServiceCard>Transcreation</ServiceCard>
              </div>
              <div class="service">
                <ServiceCard>Terminology & Corpus Management</ServiceCard>
              </div>
            </div>
          </section>
          <section id="portfolio">
            <h2>Portfolio</h2>
            <p>In 4 years of experience, I've translated, edited and tested</p>

            <SlotCounter
              client:visible
              value="+1.500.000"
              startValue="??.???.???"
              duration={2}
            />

            <p class="some-of-games">
              These are some of the games I've taken part in…
            </p>
            <div class="game-collection">
              <div class="games-grid">
                {
                  visibleGames.map((game) => {
                    const imagePath = `/src/assets/games/${game.image}`;
                    return (
                      <article class="game-item">
                        <GameCard
                          title={game.name}
                          developer={game.developer}
                          url={game.url}
                          image={gameImages[imagePath].default}
                        />
                      </article>
                    );
                  })
                }
              </div>

              {
                hiddenBatches.map((batch) => (
                  <div class="collapsible-batch" inert>
                    <div class="batch-inner">
                      <div class="games-grid">
                        {batch.map((game) => {
                          const imagePath = `/src/assets/games/${game.image}`;
                          return (
                            <article class="game-item">
                              <GameCard
                                title={game.name}
                                developer={game.developer}
                                url={game.url}
                                image={gameImages[imagePath].default}
                              />
                            </article>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                ))
              }
              <SeeMore class="load-more" id="load-more-btn"> See more </SeeMore>
            </div>
          </section>
          <section id="clients" class="clients">
            <h2>Partners</h2>
            <div class="clients-grid">
              <div class="client">
                <Frame
                  src={igg.src}
                  alt="IGG Gamers at Heart"
                  title="IGG Gamers at Heart"
                  link="https://www.igg.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={altagram.src}
                  alt="Altagram Group"
                  title="Altagram Group"
                  link="https://altagram.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={loki.src}
                  alt="Loki"
                  title="Loki"
                  link="https://www.lokilize.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={taima.src}
                  alt="Taima Translations"
                  title="Taima Translations"
                  link="https://www.taimatranslations.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={gamescribes.src}
                  alt="GameScribes"
                  title="GameScribes"
                  link="https://www.gamescribes.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={onesky.src}
                  alt="OneSky"
                  title="OneSky"
                  link="https://www.oneskyapp.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={wordarch.src}
                  alt="Wordarch Studio"
                  title="Wordarch Studio"
                  link="https://wordarch.uk/"
                />
              </div>
              <div class="client">
                <Frame
                  src={locpick.src}
                  alt="Locpick"
                  title="Locpick"
                  link="https://locpick.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={digital_hearts.src}
                  alt="Digital Hearts"
                  title="Digital Hearts"
                  link="https://www.digitalhearts.com/en/"
                />
              </div>
              <div class="client">
                <Frame
                  src={linguitronics.src}
                  alt="Linguitronics"
                  title="Linguitronics"
                  link="https://www.linguitronics.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={active_gaming_media.src}
                  alt="Active Gaming Media"
                  title="Active Gaming Media"
                  link="https://www.activegamingmedia.com/index.php/en/home-en/"
                />
              </div>
              <div class="client">
                <Frame src={indie.src} alt="Indie Devs" title="Indie Devs" />
              </div>
            </div>
          </section>
        </main>
        <section id="testimonials" class="testimonials">
          <h2>Testimonials</h2>
          <Testimonials />
        </section>
        <section id="contact">
          <h2>Contact</h2>
          <div>
            <div>
              <h3>Message me!</h3>
              <Form />
            </div>
            <div>
              <h3>Or reach out through…</h3>
              <div class="socials">
                <SocialLink
                  icon="linkedin"
                  link="https://linkedin.com/in/samutoga"
                  >linkedin.com/in/&#8203samutoga</SocialLink
                >
                <SocialLink icon="proz" link="https://proz.com/profile/3570698"
                  >proz.com/profile/3570698</SocialLink
                >
                <SocialLink icon="x" link="https://x.com/Samutoga"
                  >@Samutoga</SocialLink
                >
                <SocialLink
                  icon="bluesky"
                  link="https://bsky.app/profile/samutoga.bsky.social"
                  >@samutoga&#8203.bsky.social</SocialLink
                >
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </body>
  <Footer />
</html>

<script src="../scripts/fitText.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const seeMoreButton = document.querySelector("#load-more-btn");

    if (seeMoreButton) {
      seeMoreButton.addEventListener("click", () => {
        const nextBatch = document.querySelector(
          ".collapsible-batch:not(.is-expanded)",
        );

        if (nextBatch) {
          nextBatch.classList.add("is-expanded");
          nextBatch.removeAttribute("inert");

          const remainingBatches = document.querySelector(
            ".collapsible-batch:not(.is-expanded)",
          );

          if (!remainingBatches) {
            seeMoreButton.textContent = "That's all, folks!";
            seeMoreButton.classList.add("load-more-disabled");
          }
        }
      });
    }
  });
</script>
