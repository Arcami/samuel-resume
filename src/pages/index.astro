---
// 1. Types
import type { ImageMetadata } from "astro";

// 2. Astro & Built-in Utilities
import { Image } from "astro:assets";

// 3. Styles
import "@/styles/global.css";

// 4. Components
import DownloadCv from "@/components/DownloadCv.astro";
import Frame from "@/components/Frame.astro";
import ServiceButton from "@/components/ServiceButton.astro";
import GameCard from "@/components/GameCard.astro";
import SeeMore from "@/components/SeeMore.astro";
import Form from "@/components/Form.astro";
import SlotCounter from "@/components/SlotCounter";
import SocialLink from "@/components/SocialLink.astro";
import Testimonials from "@/components/Testimonials.astro";

// 5. Data
import translatedGames from "@/data/games.json";

// 6. Assets (Static Imports for Logos/UI)
import igg from "@assets/logos/igg.png";
import loki from "@assets/logos/loki.png";
import altagram from "@assets/logos/altagram.png";
import indie from "@assets/logos/indie.png";
import speakerImg from "@assets/speaker.png";

// 7. Dynamic Asset Logic
const gameImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/games/*.{jpeg,jpg,png,gif}",
  { eager: true }
);

// --- PAGINATION LOGIC ---
// 1. First 6 games are always visible
const visibleGames = translatedGames.slice(0, 6);

// 2. The rest are grouped into batches of 6 for the animation
const hiddenBatches = [];
for (let i = 6; i < translatedGames.length; i += 6) {
  hiddenBatches.push(translatedGames.slice(i, i + 6));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>Samuel de la Torre's resumé</title>
  </head>
  <body>
    <div class="background">
      <div class="padding">
        <main>
          <h1 class="visually-hidden">Samuel de la Torre's portfolio</h1>
          <section id="about-me">
            <h2>About me</h2>
            <div>
              <div class="sam">
                <Frame
                  src="samuel.jpg"
                  alt="Samuel de la Torre Galán"
                  title="Samuel de la Torre Galán"
                />
              </div>
              <p>
                Hi there! I'm Samuel de la Torre Galán. I'm a freelance
                EN/DE&gt;ES translator with 4+ years of experience, and I
                specialize in video game, software, and web localization.<br
                /><br />I've worked mostly on popular mobile titles, as well as
                some multiplatform indie games. As a gamer and a translator,
                genres I'm keen on are visual novel, adventure, MMORPG,
                strategy, and fantasy, but I'm comfortable with any other style
                or subject and always up for a challenge!
              </p>
            </div>
            <DownloadCv />
          </section>
          <section class="services">
            <h2>Services</h2>
            <div class="services-grid">
              <div class="service">
                <ServiceButton
                  >Localization of video games, software, apps, and webs</ServiceButton
                >
              </div>
              <div class="service">
                <ServiceButton>
                  Translation of legal, technical, and advertising texts related
                  to the industry
                </ServiceButton>
              </div>
              <div class="service">
                <ServiceButton>LQA & Testing</ServiceButton>
              </div>
              <div class="service">
                <ServiceButton>Proofreading & Editing</ServiceButton>
              </div>
              <div class="service">
                <ServiceButton>Transcreation</ServiceButton>
              </div>
              <div class="service">
                <ServiceButton>Terminology & Corpus Management</ServiceButton>
              </div>
            </div>
          </section>
          <section id="portfolio">
            <h2>Portfolio</h2>
            <p>In 4 years of experience, I've translated, edited and tested</p>
            <span
              class="translated-words"
              style={{ "--speaker-icon": `url('${speakerImg.src}')` }}
            >
              <SlotCounter
                client:visible
                value="+1.300.000"
                startValue="??.???.???"
                duration={2}
              />
              words
            </span>
            <p class="some-of-games">
              These are some of the games I've taken part in…
            </p>
            <div class="game-collection">
              {/* 1. Visible Grid */}
              <div class="games-grid">
                {
                  visibleGames.map((game) => {
                    const imagePath = `/src/assets/games/${game.image}`;
                    return (
                      <article class="game-item">
                        <GameCard
                          title={game.name}
                          developer={game.developer}
                          url={game.url}
                          image={gameImages[imagePath].default}
                        />
                      </article>
                    );
                  })
                }
              </div>
              {/* 2. Hidden Batches (Collapsible) */}
              {
                hiddenBatches.map((batch) => (
                  <div class="collapsible-batch">
                    <div class="batch-inner">
                      {/* Padding top is applied here to avoid animation jumps */}
                      <div class="games-grid" style="">
                        {batch.map((game) => {
                          const imagePath = `/src/assets/games/${game.image}`;
                          return (
                            <article class="game-item">
                              <GameCard
                                title={game.name}
                                developer={game.developer}
                                url={game.url}
                                image={gameImages[imagePath].default}
                              />
                            </article>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                ))
              }
              <SeeMore class="load-more" id="load-more-btn"> See more </SeeMore>
            </div>
          </section>
          <section class="clients">
            <h2>Clients</h2>
            <div class="clients-grid">
              <div class="client">
                <Frame
                  src={igg.src}
                  alt="IGG Gamers at Heart"
                  title="IGG Gamers at Heart"
                  link="https://www.igg.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={loki.src}
                  alt="Loki"
                  title="Loki"
                  link="https://www.lokilize.com/"
                />
              </div>
              <div class="client">
                <Frame
                  src={altagram.src}
                  alt="Altagram Group"
                  title="Altagram Group"
                  link="https://altagram.com/"
                />
              </div>
              <div class="client">
                <Frame src={indie.src} alt="Indie Devs" title="Indie Devs" />
              </div>
            </div>
          </section>
          <section class="testimonials">
            <h2>Testimonials</h2>
            <Testimonials />
          </section>
          <section id="contact-section">
            <h2>Contact</h2>
            <div>
              <div>
                <h3>Message me!</h3>
                <Form />
              </div>
              <div>
                <h3>Or reach out through…</h3>
                <div class="socials">
                  <SocialLink icon="email"
                    >samdelatorregalan@gmail.com</SocialLink
                  >
                  <SocialLink icon="linkedin"
                    >linkedin.com/in/samutoga</SocialLink
                  >
                  <SocialLink icon="x">@Samutoga</SocialLink>
                  <SocialLink icon="bluesky">@samutoga.bsky.social</SocialLink>
                </div>
              </div>
            </div>
          </section>
        </main>
        <footer></footer>
      </div>
    </div>
  </body>

  <script>
    function fitText() {
      // Select all buttons with the class we added to the component
      const buttons = document.querySelectorAll<HTMLElement>(".service-btn");

      buttons.forEach((button) => {
        const span = button.querySelector<HTMLElement>(".fit-text");
        if (!span) return;

        const maxFontSize = 18; // The ideal starting font size
        const minFontSize = 4; // Minimum legible size

        // Calculate usable internal height
        const styles = window.getComputedStyle(button);
        const paddingTotal =
          parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
        const availableHeight = button.offsetHeight - paddingTotal;

        // Reset to max size first
        let fontSize = maxFontSize;
        span.style.fontSize = `${fontSize}px`;

        // Shrink loop: if text height (scrollHeight) > button height, reduce font
        while (span.scrollHeight > availableHeight && fontSize > minFontSize) {
          fontSize -= 0.5;
          span.style.fontSize = `${fontSize}px`;
        }
      });
    }

    // 1. Run when DOM is ready
    document.addEventListener("DOMContentLoaded", fitText);

    // 2. Run after fonts load (very important for 'Press Start K' and 'Pixelify')
    if (document.fonts) {
      document.fonts.ready.then(fitText);
    }

    // 3. Run on window resize (debounced)
    let resizeTimeout: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(fitText, 100);
    });

    // --- ANIMATION LOGIC ---
    document.addEventListener("DOMContentLoaded", () => {
      const seeMoreButton = document.querySelector("#load-more-btn");

      if (seeMoreButton) {
        seeMoreButton.addEventListener("click", () => {
          // Simply find the next closed batch and open it
          const nextBatch = document.querySelector(
            ".collapsible-batch:not(.is-expanded)"
          );

          if (nextBatch) {
            nextBatch.classList.add("is-expanded");
          }
        });
      }
    });
  </script>
</html>
